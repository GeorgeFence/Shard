@{
    Layout = "~/Views/Shared/_IframeLayout.cshtml";
}
<style>
    .menu-panel {
        width: 100%;
        height: 100%;
        background: #ffffff;
        color: #1f2937;
        display: flex;
        flex-direction: column;
        padding: 15px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }


    /* User card */

    .menu-user {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 12px;
        background: #f3f4f6;
    }


        .menu-user i {
            font-size: 38px;
            color: #374151;
        }


        .menu-user strong {
            color: #111827;
        }


        .menu-user span {
            display: block;
            font-size: 12px;
            color: #6b7280;
        }



    /* Explorer header */

    .explorer-header {
        margin-top: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
    }


    .explorer-actions button {
        background: none;
        border: 0;
        color: #6b7280;
        cursor: pointer;
        padding: 5px;
        border-radius: 6px;
    }


        .explorer-actions button:hover {
            background: #e5e7eb;
            color: #111827;
        }



    /* File tree */

    .file-tree {
        margin-top: 15px;
        font-size: 14px;
    }


    .tree-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px;
        border-radius: 8px;
        cursor: pointer;
        color: #374151;
    }


        .tree-item:hover {
            background: #f3f4f6;
        }


        .tree-item.active {
            background: #2563eb;
            color: white;
        }


            .tree-item.active i {
                color: white;
            }


    .tree-children {
        margin-left: 22px;
    }



    /* Bottom */

    .menu-bottom {
        margin-top: auto;
        border-top: 1px solid #e5e7eb;
        padding-top: 10px;
    }


        .menu-bottom a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            color: #374151;
            text-decoration: none;
            border-radius: 8px;
        }


            .menu-bottom a:hover {
                background: #f3f4f6;
                color: #111827;
            }
</style>
<div class="menu-panel">

    <div class="menu-user">
        <i class="bi bi-person-circle"></i>

        <div>
            <strong>@User.Identity?.Name</strong>
            <span>Workspace</span>
        </div>
    </div>


    <iframe src="/explorer"
        width="100%"
        height="100%"
            style="border:none; overflow:hidden; display:flex; flex-direction:column;"
        title="File Explorer">
</iframe>


    <div class="menu-bottom">

        <a>
            <i class="bi bi-gear"></i>
            Settings
        </a>

        <a>
            <i class="bi bi-question-circle"></i>
            Help
        </a>

    </div>

</div>