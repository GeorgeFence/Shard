@{
    Layout = "~/Views/Shared/_IframeLayout.cshtml";
}

<div class="explorer">

    <div class="toolbar">

        <button id="backBtn">
            <i class="bi bi-arrow-left"></i>
        </button>

        <button id="forwardBtn">
            <i class="bi bi-arrow-right"></i>
        </button>

        <button id="refreshBtn">
            <i class="bi bi-arrow-clockwise"></i>
        </button>

        <div class="address">

            <i class="bi bi-folder-fill"></i>

            <span id="pathText">
                Shard Drive
            </span>

        </div>

        <button id="newFileBtn">
            <i class="bi bi-file-earmark-plus"></i>
        </button>

        <button id="newFolderBtn">
            <i class="bi bi-folder-plus"></i>
        </button>

    </div>


    <div class="content">

        <aside class="sidebar">

            <h6>
                Quick Access
            </h6>

            <div class="item active"
                 onclick="navigate('')">

                <i class="bi bi-house-fill"></i>
                Home

            </div>

            <h6>
                Folders
            </h6>

            <div class="item"
                 onclick="navigate('Documents')">

                <i class="bi bi-folder-fill"></i>
                Documents

            </div>

            <div class="item"
                 onclick="navigate('School')">

                <i class="bi bi-mortarboard-fill"></i>
                School

            </div>

            <div class="item"
                 onclick="navigate('Projects')">

                <i class="bi bi-code-slash"></i>
                Projects

            </div>

        </aside>


        <main class="files">

            <div id="fileGrid"
                 class="grid">
            </div>

        </main>

    </div>
</div>

<div id="dialog"
     class="dialog hidden">

    <div class="dialog-box">

        <h4>
            New HTML file
        </h4>

        <input id="fileName"
               placeholder="filename" />

        <div class="dialog-buttons">

            <button id="cancel">
                Cancel
            </button>

            <button id="create">
                Create
            </button>

        </div>

    </div>

</div>

<style>

    body {
        margin: 0;
    }

    .explorer {
        height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: "Segoe UI", system-ui;
        background: #fff;
        color: #202020;
    }

    .toolbar {
        height: 52px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        border-bottom: 1px solid #ddd;
    }

        .toolbar button {
            width: 36px;
            height: 36px;
            border: 0;
            background: none;
            border-radius: 8px;
            cursor: pointer;
        }

            .toolbar button:hover {
                background: #eee;
            }

    .address {
        flex: 1;
        height: 36px;
        background: #f3f3f3;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 15px;
    }

    .content {
        flex: 1;
        display: flex;
    }

    .sidebar {
        width: 230px;
        border-right: 1px solid #ddd;
        padding: 12px;
    }

        .sidebar h6 {
            margin: 18px 8px 8px;
            color: #777;
            font-size: 12px;
        }

    .item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
    }

        .item:hover {
            background: #eee;
        }

        .item.active {
            background: #dbeafe;
            color: #2563eb;
        }

    .files {
        flex: 1;
        padding: 25px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 120px);
        gap: 20px;
    }

    .file {
        padding: 15px;
        text-align: center;
        border-radius: 12px;
        cursor: pointer;
        overflow: hidden;
    }

        .file:hover {
            background: #e5f1ff;
        }

        .file i {
            display: block;
            font-size: 45px;
            margin-bottom: 8px;
        }

    .folder {
        color: #fbbf24;
    }

    .html {
        color: #f97316;
    }

    .file-name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dialog {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.25);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .dialog.hidden {
            display: none;
        }

    .dialog-box {
        background: white;
        padding: 25px;
        border-radius: 15px;
        width: 320px;
        box-shadow: 0 10px 40px #0004;
    }

        .dialog-box input {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

    .dialog-buttons {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

        .dialog-buttons button {
            padding: 8px 16px;
            border-radius: 8px;
            border: 0;
            cursor: pointer;
        }

    #create {
        background: #2563eb;
        color: white;
    }

</style>

<script>

    let currentPath = "";

    let backStack = [];

    let forwardStack = [];


    function progress(value, text) {

        window.parent.parent.progress(
            value,
            text
        );

    }

    async function loadFolder(path) {

        progress(
            10,
            "Loading folder..."
        );

        try {

            const res =
                await fetch(
                    "/files/Index?path="
                    + encodeURIComponent(path)
                );


            if (!res.ok) {

                progress(
                    100,
                    "Failed to load folder"
                );

                return;

            }


            progress(
                60,
                "Reading files..."
            );


            const data =
                await res.json();


            currentPath = path;


            document
                .getElementById("pathText")
                .innerText =
                path || "Shard Drive";


            render(data);


            progress(
                100,
                "Ready"
            );


            setTimeout(() => {

                progress(
                    0,
                    "Ready"
                );

            }, 500);

        }
        catch (error) {

            console.error(error);

            progress(
                100,
                "Error"
            );

        }

    }

    function render(data) {

        const grid =
            document.getElementById(
                "fileGrid"
            );


        grid.innerHTML = "";

        data.folders.forEach(folder => {

            const div =
                document.createElement("div");


            div.className = "file";


            div.innerHTML = `

                    <i class="bi bi-folder-fill folder"></i>

                    <span class="file-name">
                        ${folder}
                    </span>

                `;


            div.onclick = () => {

                backStack.push(
                    currentPath
                );


                forwardStack = [];


                const newPath =
                    currentPath
                        ? currentPath + "/" + folder
                        : folder;


                loadFolder(
                    newPath
                );

            };


            grid.appendChild(div);

        });

        data.files.forEach(file => {

            const div =
                document.createElement("div");


            div.className = "file";

            const isHtml =
                file
                    .toLowerCase()
                    .endsWith(".html");


            const isXml =
                file
                    .toLowerCase()
                    .endsWith(".xml");


            div.innerHTML = `

                    <i class="bi ${isHtml || isXml
                    ? "bi-file-earmark-code html"
                    : "bi-file-earmark"
                }"></i>

                    <span class="file-name">
                        ${file}
                    </span>

                `;

            div.onclick = () => {

                openFile(
                    file
                );

            };


            grid.appendChild(div);

        });

    }

    async function openFile(file) {
        let path =
            currentPath
                ? currentPath + "/" + file
                : file;


        /*
         * Explorer:
         * window
         *
         * parent:
         * hlavní iframe / menu
         *
         * parent.parent:
         * Main stránka
         */
        window.parent.parent.location.href =
            "/Editor?path=" +
            encodeURIComponent(path);
    }

    function navigate(path) {

        backStack.push(
            currentPath
        );

        forwardStack = [];


        loadFolder(
            path
        );

    }

    document
        .getElementById("refreshBtn")
        .onclick = () => {

            loadFolder(
                currentPath
            );

        };

    document
        .getElementById("backBtn")
        .onclick = () => {

            if (!backStack.length)
                return;


            forwardStack.push(
                currentPath
            );


            loadFolder(
                backStack.pop()
            );

        };

    document
        .getElementById("forwardBtn")
        .onclick = () => {

            if (!forwardStack.length)
                return;


            backStack.push(
                currentPath
            );


            loadFolder(
                forwardStack.pop()
            );

        };


    const dialog =
        document.getElementById(
            "dialog"
        );


    document
        .getElementById("newFileBtn")
        .onclick = () => {

            dialog.classList.remove(
                "hidden"
            );

        };


    document
        .getElementById("cancel")
        .onclick = () => {

            dialog.classList.add(
                "hidden"
            );

        };

    document
        .getElementById("create")
        .onclick = async () => {

            let name =
                document
                    .getElementById(
                        "fileName"
                    )
                    .value
                    .trim();


            if (!name)
                return;

            if (
                !name
                    .toLowerCase()
                    .endsWith(".html")
            ) {

                name += ".html";

            }


            const path =
                currentPath
                    ? currentPath + "/" + name
                    : name;


            progress(
                20,
                "Creating file..."
            );


            try {

                const response =
                    await fetch(
                        "/files/Save?path="
                        + encodeURIComponent(path),
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(
                                    `
    <shard-document>

        <shard-page
            width="794"
            height="1123">

        </shard-page>

    </shard-document>
    `
                                )

                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "HTTP " +
                        response.status
                    );

                }


                progress(
                    80,
                    "Refreshing..."
                );


                dialog.classList.add(
                    "hidden"
                );


                document
                    .getElementById(
                        "fileName"
                    )
                    .value = "";


                await loadFolder(
                    currentPath
                );


                progress(
                    100,
                    "File created"
                );


                setTimeout(() => {

                    progress(
                        0,
                        "Ready"
                    );

                }, 500);

            }
            catch (error) {

                console.error(error);

                progress(
                    100,
                    "Failed to create file"
                );

            }

        };

    loadFolder("");

</script>
