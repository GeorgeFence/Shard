@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="cs">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: #f1f1f1;
            -webkit-user-select: none;
            user-select: none;
        }

        #viewer {
            width: 100%;
            height: 100%;
            overflow: auto;
            padding: 40px;
            touch-action: pan-x pan-y;
            -webkit-overflow-scrolling: touch;
        }

        #documentContainer {
            width: max-content;
            min-width: 100%;
            position: relative;
        }

        shard-document {
            display: block;
        }

        shard-page {
            display: block;
            position: relative;
            width: 794px;
            height: 1123px;
            margin: 0 auto 40px auto;
            background: white;
            box-shadow: 0 3px 15px rgba(0,0,0,.15);
            overflow: hidden;
            touch-action: none;
        }

        /* =====================================================
           SELECTION
           ===================================================== */

        #selectionBox {
            position: fixed;
            display: none;
            pointer-events: none;
            border: 2px solid #2563eb;
            z-index: 9999;
            touch-action: none;
        }

        #selectionBox.active {
            display: block;
        }

        /* =====================================================
           RESIZE HANDLES
           ===================================================== */

        .resize-handle {
            position: absolute;
            width: 22px;
            height: 22px;
            background: white;
            border: 2px solid #2563eb;
            border-radius: 5px;
            pointer-events: auto;
            z-index: 10002;
            touch-action: none;
            -webkit-user-select: none;
            user-select: none;
        }

        .resize-handle.nw {
            left: -11px;
            top: -11px;
            cursor: nwse-resize;
        }

        .resize-handle.n {
            left: 50%;
            top: -11px;
            transform: translateX(-50%);
            cursor: ns-resize;
        }

        .resize-handle.ne {
            right: -11px;
            top: -11px;
            cursor: nesw-resize;
        }

        .resize-handle.w {
            left: -11px;
            top: 50%;
            transform: translateY(-50%);
            cursor: ew-resize;
        }

        .resize-handle.e {
            right: -11px;
            top: 50%;
            transform: translateY(-50%);
            cursor: ew-resize;
        }

        .resize-handle.sw {
            left: -11px;
            bottom: -11px;
            cursor: nesw-resize;
        }

        .resize-handle.s {
            left: 50%;
            bottom: -11px;
            transform: translateX(-50%);
            cursor: ns-resize;
        }

        .resize-handle.se {
            right: -11px;
            bottom: -11px;
            cursor: nwse-resize;
        }

        /* =====================================================
           DRAG HANDLE
           ===================================================== */

        #dragHandle {
            position: absolute;

            left: 50%;
            bottom: -54px;

            transform: translateX(-50%);

            width: 48px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: white;

            border: 2px solid #2563eb;
            border-radius: 8px;

            color: #2563eb;

            pointer-events: auto;

            cursor: grab;

            z-index: 10001;

            box-shadow: 0 3px 10px rgba(0,0,0,.16);

            user-select: none;
            -webkit-user-select: none;

            touch-action: none;

            transition:
                background .1s ease,
                transform .1s ease;
        }

        #dragHandle:hover {
            background: #eef4ff;
        }

        #dragHandle:active {
            cursor: grabbing;
            background: #dbeafe;
            transform: translateX(-50%) scale(.96);
        }

        #dragHandle i {
            font-size: 20px;
            line-height: 1;
            pointer-events: none;
        }

        /* =====================================================
           QUICK EDIT
           ===================================================== */

        #quickStyle {
            position: fixed;

            display: none;
            align-items: center;

            gap: 3px;

            padding: 5px;

            background: rgba(255,255,255,.96);

            border: 1px solid #dedede;

            border-radius: 10px;

            box-shadow: 0 8px 30px rgba(0,0,0,.14);

            backdrop-filter: blur(12px);

            z-index: 10000;

            user-select: none;
            -webkit-user-select: none;

            touch-action: manipulation;
        }

        #quickStyle.active {
            display: flex;
        }

        /* =====================================================
           BUTTON
           ===================================================== */

        .quick-button {
            width: 32px;
            height: 32px;

            padding: 0;

            border: 0;
            border-radius: 6px;

            background: transparent;
            color: #444;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 16px;

            cursor: pointer;

            transition:
                background .12s ease,
                color .12s ease;

            touch-action: manipulation;
        }

        .quick-button:hover {
            background: #f0f0f0;
        }

        .quick-button.active {
            background: #e8efff;
            color: #2563eb;
        }

        /* =====================================================
           GROUP
           ===================================================== */

        .quick-group {
            display: flex;

            gap: 2px;

            padding: 0 3px;

            border-left: 1px solid #e3e3e3;

            margin-left: 2px;
        }

        /* =====================================================
           FONT
           ===================================================== */

        .quick-font {
            height: 32px;

            min-width: 105px;

            padding: 0 25px 0 9px;

            border: 1px solid #ddd;

            border-radius: 6px;

            background: #fafafa;

            color: #333;

            outline: none;

            cursor: pointer;

            touch-action: manipulation;
        }

        .quick-font:hover {
            background: #f3f3f3;
        }

        .quick-font:focus {
            border-color: #2563eb;
        }

        /* =====================================================
           NUMBER
           ===================================================== */

        .quick-number {
            height: 32px;

            display: flex;
            align-items: center;

            padding: 0 7px;

            gap: 2px;

            border: 1px solid #ddd;

            border-radius: 6px;

            background: #fafafa;
        }

        .quick-number input {
            width: 42px;

            border: 0;
            outline: none;

            background: transparent;

            text-align: center;
        }

        .quick-number span {
            color: #888;
            font-size: 11px;
        }

        /* =====================================================
           COLOR
           ===================================================== */

        .quick-color {
            width: 32px;
            height: 32px;

            padding: 5px;

            display: block;

            border: 1px solid #ddd;

            border-radius: 6px;

            cursor: pointer;

            background:
                linear-gradient(
                    var(--color),
                    var(--color)
                );
        }

        .quick-color input {
            width: 100%;
            height: 100%;

            opacity: 0;

            cursor: pointer;
        }

        /* =====================================================
           SELECT
           ===================================================== */

        .quick-select {
            height: 32px;

            padding: 0 24px 0 8px;

            border: 1px solid #ddd;

            border-radius: 6px;

            background: #fafafa;

            outline: none;
        }

        /* =====================================================
           LEGACY STYLE BUTTON
           ===================================================== */

        .style-button {
            width: 30px;
            height: 30px;

            border: none;

            background: transparent;

            border-radius: 5px;

            display: flex;
            align-items: center;
            justify-content: center;

            cursor: pointer;

            color: #333;
        }

        .style-button:hover {
            background: #eeeeee;
        }

        .style-button.active {
            background: #dbeafe;
            color: #2563eb;
        }

        .style-divider {
            width: 1px;
            height: 22px;

            background: #ddd;

            margin: 0 3px;
        }

        #textColor {
            width: 28px;
            height: 28px;

            padding: 2px;

            border: none;

            background: transparent;

            cursor: pointer;
        }

        /* =====================================================
           ERROR
           ===================================================== */

        .error {
            width: 500px;
            max-width: 90%;

            margin: 100px auto;

            padding: 25px;

            background: white;

            border-radius: 12px;

            box-shadow: 0 5px 25px rgba(0,0,0,.15);

            color: #b00020;
        }

        /* =====================================================
           TOUCH DISPLAY
           ===================================================== */

        @@media (pointer: coarse) {

            .resize-handle {
                width: 26px;
                height: 26px;
            }

            .resize-handle.nw {
                left: -13px;
                top: -13px;
            }

            .resize-handle.n {
                top: -13px;
            }

            .resize-handle.ne {
                right: -13px;
                top: -13px;
            }

            .resize-handle.w {
                left: -13px;
            }

            .resize-handle.e {
                right: -13px;
            }

            .resize-handle.sw {
                left: -13px;
                bottom: -13px;
            }

            .resize-handle.s {
                bottom: -13px;
            }

            .resize-handle.se {
                right: -13px;
                bottom: -13px;
            }

            #dragHandle {
                width: 56px;
                height: 42px;
                bottom: -60px;
            }

            #dragHandle i {
                font-size: 23px;
            }

            .quick-button {
                width: 40px;
                height: 40px;
            }

            .quick-font {
                height: 40px;
            }

            .quick-number {
                height: 40px;
            }
        }

    </style>

</head>

<body>

    <div id="viewer">

        <div id="documentContainer">
            Loading document...
        </div>

    </div>


    <!-- =========================================================
         SELECTION BOX
         ========================================================= -->

    <div id="selectionBox">

        <div class="resize-handle nw"></div>

        <div class="resize-handle n"></div>

        <div class="resize-handle ne"></div>


        <div class="resize-handle w"></div>

        <div class="resize-handle e"></div>


        <div class="resize-handle sw"></div>

        <div class="resize-handle s"></div>

        <div class="resize-handle se"></div>


        <!-- =====================================================
             DRAG HANDLE
             ===================================================== -->

        <div id="dragHandle">

            <i class="bi bi-grip-horizontal"></i>

        </div>

    </div>


    <!-- =========================================================
         QUICK EDIT
         ========================================================= -->

    <div id="quickStyle"></div>


    <script type="module"
            src="~/js/editor/core/editor.js"></script>

</body>

</html>