<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shard</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Shard.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <partial name="_HeaderLoggedIn" />

        }
        else
        {
            <partial name="_HeaderGuest" />
        }
       
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="menuContainer" style="display:none;" class="menuContainer">
            <iframe src="/menu"></iframe>
        </div>
    }
    
    <div id="mainContent" class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="bottomStatusBar">

            <div class="status-section left">

                <i class="bi bi-person-circle"></i>

                <span>
                    @User.Identity.Name
                </span>


                <span class="status-divider"></span>


                <i class="bi bi-file-earmark-text"></i>

                <span id="documentInfo">
                    0 pages
                </span>

            </div>



            <div class="status-section right">


                <span id="statusMessage">
                    Ready
                </span>


                <div class="status-progress">

                    <div id="statusProgressFill"></div>

                </div>


                <span id="statusProgressText">
                    0%
                </span>


            </div>


        </div>
    }
        else
        {
        <footer class="border-top footer text-muted">
            <div class="container-fluid text-center">
                &copy; 2026 - Shard - <a href="https://nullware.app/">NullWare</a>
            </div>
        </footer>
        }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
